# Context is the REPOSITORY ROOT (docker build -f server/Dockerfile .).
# BuildKit reads this file because it is named after the Dockerfile
# (server/Dockerfile -> server/Dockerfile.dockerignore); the root .dockerignore,
# if any, is ignored for this build.
# Allow-list: everything is excluded except what server/Dockerfile copies.
*
!package.json
!package-lock.json
!server
!src/core/extensions
!src/components/ui
!src/lib
!src/locales
!desktop/runtime/compatibility
!shared/aniyomi
**/node_modules
**/.env*
**/.dev.vars
server/dist
server/data
server/**/data
