# Copy to local.properties (gitignored) and fill in. Nothing here is ever committed.
sdk.dir=D:/Android-SDK
# parity wave A (docs/redesign/15-parity-wave-a-contract-android.md §3.3): OAuth client ids of the list providers (public ids, not secrets;
# still not committed). Also readable from env. Both are OPTIONAL: without one, "Vincular" is disabled with the reason. Register the
# Android client at each provider with redirect URI tatakai://oauth/anilist and tatakai://oauth/mal (one client per platform: AniList
# allows a single redirect per client, desktop uses loopback).
# There is no own login any more (2026-11-09): the former hosted-backend URL / anon key entries are gone.
TATAKAI_ANILIST_CLIENT_ID=
TATAKAI_MAL_CLIENT_ID=
